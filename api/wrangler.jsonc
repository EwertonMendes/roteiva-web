{
  "name": "roteiva-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "roteiva-api-dev",
      "workers_dev": true,
      "preview_urls": false,
      "account_id": "b3855f9c192541a01a45b2dae7b6a7f8",
      "vars": {
        "ENVIRONMENT": "dev",
        "ACCOUNT_DELETION_ENABLED": "true",
        "ACCESS_PROVISION_ON_DRIVE": "false",
        "FIREBASE_PROJECT_ID": "roteiva-web-dev",
        "FRONTEND_ORIGIN": "https://roteiva-web-dev.web.app",
        "OAUTH_REDIRECT_URI": "https://roteiva-api-dev.ewertonmendes9.workers.dev/oauth/drive/callback",
        "OAUTH_ENABLED": "true",
        "DROPBOX_ENABLED": "false",
        "DROPBOX_OAUTH_REDIRECT_URI": "https://roteiva-api-dev.ewertonmendes9.workers.dev/oauth/dropbox/callback",
        "TOKEN_KEY_VERSION": "v1",
        "GOOGLE_CLIENT_ID": "479738001561-4gu97o42v4m8kiq1bga8ck3msmjp0me3.apps.googleusercontent.com"
      },
      "triggers": {
        "crons": [
          "* * * * *",
          "*/15 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roteiva-drive-dev",
          "database_id": "302adc88-76b2-4827-bb16-99662fa0408b",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": false
        }
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMIT",
          "namespace_id": "479738001561",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "API_THUMB_LIMIT",
          "namespace_id": "479738001562",
          "simple": {
            "limit": 240,
            "period": 60
          },
        {
          "name": "API_UPLOAD_LIMIT",
          "namespace_id": "479738001563",
          "simple": {
            "limit": 240,
            "period": 60
          }
        }
        }
      ]
    }
  }
}
