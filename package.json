{
  "name": "roteiva-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base /roteiva-web/ --outDir dist-pages",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:calendar && pnpm run test:finance",
    "test:calendar": "node --experimental-strip-types tests/studio-calendar.test.mjs",
    "test:finance": "node --experimental-strip-types tests/studio-finance.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
