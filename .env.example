# Copy to .env.local for local development. Public SDK config; never add admin credentials.
VITE_APP_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=roteiva-web-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=roteiva-web-dev
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=533435008961
# Optional; no Storage bucket is provisioned or used by this implementation.
VITE_FIREBASE_STORAGE_BUCKET=
# Emulator builds only: use project demo-roteiva and dummy SDK values.
VITE_USE_EMULATORS=false
# Dropbox visible only once the backend OAuth app and E2E are configured.
VITE_DROPBOX_ENABLED=false
