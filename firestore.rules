rules_version = '2';
// Data model: users/{uid}: private profile with explicit first-time registration.
// All child documents have ownerUid=path UID, schemaVersion=1, incrementing revision,
// server timestamps createdAt/updatedAt. No user roles, entitlements, shared access or arrays.
// clients: contact/package + integer monthlyFeeCents; projects: briefing/status/date;
// tasks/deliveries: independent bool checklist documents scoped to a project/client;
// events: YYYY-MM-DD civil date + local HH:mm; financeEntries: integer amountCents;
// activities: private UI history (not a trusted audit log); preferences/ui: theme.
// Explicit field whitelists, types and size limits are enforced on create AND update.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth!=null && request.auth.uid==uid; }
    function member(uid) { return owner(uid) && exists(/databases/$(database)/documents/users/$(uid)); }
    function text(v,min,max) { return v is string && v.size()>=min && v.size()<=max; }
    function clock(v) { return text(v,5,5) && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function civilDate(v) {
      let parts=v.split('-');
      let y=int(parts[0]);
      let m=int(parts[1]);
      let d=int(parts[2]);
      let leap=y%400==0 || (y%4==0 && y%100!=0);
      let days=m==2 ? (leap ? 29:28) : (m in [4,6,9,11] ? 30:31);
      return text(v,10,10) && v.matches('^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])-[0-9]{2}$') && d>=1 && d<=days;
    }
    function linked(uid,name,id) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/$(name)/$(string(id))).data.ownerUid==uid;
    }
    function metadata(d,uid) {
      return d.ownerUid==uid && d.schemaVersion==1 && d.revision is int && d.revision>=1 &&
        d.createdAt is timestamp && d.updatedAt==request.time;
    }
    function creating(d) { return d.createdAt==request.time && d.revision==1; }
    function updating(d) {
      return d.createdAt==resource.data.createdAt && d.ownerUid==resource.data.ownerUid &&
        d.schemaVersion==resource.data.schemaVersion && d.revision==resource.data.revision+1;
    }
    function valid_clients(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","name","contact","email","phone","color","initials","type","since","packageTitle","monthlyDeliverables","monthlyFeeCents"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","name","contact","email","phone","color","initials","type","since","packageTitle","monthlyDeliverables","monthlyFeeCents"]) &&
        metadata(d,uid) &&
        d.id is int && d.id>0 && d.id<=9007199254740991 && string(d.id)==id &&
        text(d.name,1,200) &&
        text(d.contact,0,500) &&
        text(d.email,0,254) && (d.email=='' || d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
        text(d.phone,0,500) &&
        text(d.color,0,80) &&
        text(d.initials,0,80) &&
        d.type in ["Recorrente","Avulso"] &&
        text(d.since,0,80) &&
        text(d.packageTitle,0,500) &&
        d.monthlyDeliverables is int && d.monthlyDeliverables>=0 && d.monthlyDeliverables<=100 &&
        d.monthlyFeeCents is int && d.monthlyFeeCents>=0 && d.monthlyFeeCents<=100000000000;
    }
    function valid_projects(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","name","clientId","client","status","dueDate","description","template","color","initials"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","name","clientId","client","status","dueDate","description","template","color","initials"]) &&
        metadata(d,uid) &&
        d.id is int && d.id>0 && d.id<=9007199254740991 && string(d.id)==id &&
        text(d.name,1,200) &&
        d.clientId is int && (d.clientId==0 || (d.clientId>0 && linked(uid,'clients',d.clientId))) &&
        text(d.client,0,500) &&
        d.status in ["Em produção","Em aprovação","Ajustes","Aprovado"] &&
        (d.dueDate=='' || civilDate(d.dueDate)) &&
        text(d.description,0,10000) &&
        text(d.template,0,80) &&
        text(d.color,0,80) &&
        text(d.initials,0,80);
    }
    function valid_tasks(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","projectId","title","done"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","projectId","title","done"]) &&
        metadata(d,uid) &&
        d.id is int && d.id>0 && d.id<=9007199254740991 && string(d.id)==id &&
        d.projectId is int && d.projectId>0 && linked(uid,'projects',d.projectId) &&
        text(d.title,1,200) &&
        d.done is bool;
    }
    function valid_deliveries(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","clientId","title","month","done"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","clientId","title","month","done"]) &&
        metadata(d,uid) &&
        d.id is int && d.id>0 && d.id<=9007199254740991 && string(d.id)==id &&
        d.clientId is int && d.clientId>0 && linked(uid,'clients',d.clientId) &&
        text(d.title,1,200) &&
        text(d.month,7,7) && d.month.matches('^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])$') &&
        d.done is bool;
    }
    function valid_events(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","projectId","title","date","time","endTime","autoDeadline","type","client"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","projectId","title","date","time","endTime","autoDeadline","type","client"]) &&
        metadata(d,uid) &&
        d.id is int && d.id>0 && d.id<=9007199254740991 && string(d.id)==id &&
        d.projectId is int && (d.projectId==0 || (d.projectId>0 && linked(uid,'projects',d.projectId))) &&
        text(d.title,1,200) &&
        civilDate(d.date) &&
        clock(d.time) &&
        (d.endTime=='' || (clock(d.endTime) && d.endTime>d.time)) &&
        d.autoDeadline is bool &&
        d.type in ["Produção","Entrega","Reunião","Aprovação"] &&
        text(d.client,0,500);
    }
    function valid_financeEntries(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","projectId","clientId","project","client","kind","amountCents","date","status"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","projectId","clientId","project","client","kind","amountCents","date","status"]) &&
        metadata(d,uid) &&
        d.id is int && d.id>0 && d.id<=9007199254740991 && string(d.id)==id &&
        d.projectId is int && (d.projectId==0 || (d.projectId>0 && linked(uid,'projects',d.projectId))) &&
        d.clientId is int && (d.clientId==0 || (d.clientId>0 && linked(uid,'clients',d.clientId))) &&
        text(d.project,1,200) &&
        text(d.client,0,500) &&
        d.kind in ["income","expense"] &&
        d.amountCents is int && d.amountCents>=1 && d.amountCents<=100000000000 &&
        civilDate(d.date) &&
        d.status in ["Recebido","A receber"];
    }
    function valid_activities(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","text","when"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","id","text","when"]) &&
        metadata(d,uid) &&
        d.id is string && d.id.size()>0 && d.id.size()<=64 && d.id==id &&
        text(d.text,0,500) &&
        text(d.when,24,24) && d.when.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    function valid_driveFolders(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","projectId","connectionId","folderId","folderName","createdAt"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","projectId","connectionId","folderId","folderName","createdAt"]) &&
        d.ownerUid==uid && d.schemaVersion==1 &&
        d.projectId is int && d.projectId>0 &&
        exists(/databases/$(database)/documents/users/$(uid)/projects/$(string(d.projectId))) &&
        text(d.connectionId,36,36) && d.connectionId.matches('^[a-zA-Z0-9-]{36}
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","theme"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","theme"]) &&
        metadata(d,uid) &&
        d.theme in ["light","dark"];
    }

    function valid_sync(d,uid,id) {
      return id=='state' &&
        d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","domains","counts"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","domains","counts"]) &&
        metadata(d,uid) && d.revision is int && d.revision>=1 &&
        d.domains is map && d.counts is map &&
        d.domains.keys().hasAll(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.domains.keys().hasOnly(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.counts.keys().hasAll(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.counts.keys().hasOnly(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        valid_sync_counts(d.domains) && valid_sync_counts(d.counts);
    }
    function valid_sync_counts(d) {
      return d.clients is int && d.clients>=0 && d.clients<1000000 &&
        d.projects is int && d.projects>=0 && d.projects<1000000 &&
        d.tasks is int && d.tasks>=0 && d.tasks<1000000 &&
        d.deliveries is int && d.deliveries>=0 && d.deliveries<1000000 &&
        d.events is int && d.events>=0 && d.events<1000000 &&
        d.financeEntries is int && d.financeEntries>=0 && d.financeEntries<1000000 &&
        d.activities is int && d.activities>=0 && d.activities<1000000;
    }
    function hasRegistration(d) {
      return d.keys().hasAll(["studioName","professionalType","registrationCompletedAt","dataAcknowledgedAt"]);
    }
    function modernProfile(d) {
      return hasRegistration(d) && text(d.displayName,2,120) &&
        text(d.studioName,0,120) &&
        d.professionalType in ["freelancer","studio","producer","other"] &&
        d.registrationCompletedAt is timestamp &&
        d.dataAcknowledgedAt is timestamp;
    }
    function legacyProfile(d) {
      // Accounts created before explicit onboarding keep their original registration state.
      // A legacy account may opt to configure studio/occupation without fake consent timestamps.
      return !d.keys().hasAny(["registrationCompletedAt","dataAcknowledgedAt"]) &&
        ((!d.keys().hasAny(["studioName","professionalType"])) ||
         (d.keys().hasAll(["studioName","professionalType"]) &&
          text(d.studioName,0,120) &&
          d.professionalType in ["freelancer","studio","producer","other"]));
    }
    function valid_profile(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","displayName","email","photoURL"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","displayName","email","photoURL","studioName","professionalType","registrationCompletedAt","dataAcknowledgedAt"]) &&
        metadata(d,uid) &&
        text(d.displayName,0,500) &&
        text(d.email,0,254) && (d.email=='' || d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
        text(d.photoURL,0,2048) && (d.photoURL=='' || d.photoURL.matches('^https://.*$')) &&
        (modernProfile(d) || legacyProfile(d));
    }
    function immutableRegistration(d) {
      return (legacyProfile(resource.data) && legacyProfile(d)) ||
        (modernProfile(resource.data) && modernProfile(d) &&
         d.registrationCompletedAt==resource.data.registrationCompletedAt &&
         d.dataAcknowledgedAt==resource.data.dataAcknowledgedAt);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // New users must complete the registration form. Legacy users keep their original profile.
      allow create: if owner(uid) && valid_profile(request.resource.data,uid,uid) &&
        modernProfile(request.resource.data) &&
        request.resource.data.registrationCompletedAt==request.time &&
        request.resource.data.dataAcknowledgedAt==request.time &&
        creating(request.resource.data);
      allow update: if owner(uid) && valid_profile(request.resource.data,uid,uid) &&
        immutableRegistration(request.resource.data) &&
        request.resource.data.email==resource.data.email &&
        request.resource.data.photoURL==resource.data.photoURL &&
        updating(request.resource.data);
      allow delete: if false; // Account deletion requires a future explicit cleanup process.
      match /clients/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_clients(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_clients(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /projects/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_projects(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_projects(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /tasks/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_tasks(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_tasks(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /deliveries/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_deliveries(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_deliveries(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /events/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_events(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_events(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /financeEntries/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_financeEntries(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_financeEntries(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /activities/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_activities(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_activities(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      // Private per-UID revision counters; no shared hot document across accounts.
      match /sync/{id} {
        allow read: if member(uid) && id=='state';
        allow create: if member(uid) && valid_sync(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_sync(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if false;
      }
      // Explicit folder-to-project links; file bodies and OAuth credentials never enter Firestore.
      match /driveFolders/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_driveFolders(request.resource.data,uid,id);
        allow update: if false;
        allow delete: if member(uid);
      }
      match /preferences/{id} {
        allow read: if member(uid) && id=='ui';
        allow create: if member(uid) && id=='ui' && valid_preferences(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && id=='ui' && valid_preferences(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid) && id=='ui';
      }
    }
    match /{document=**} { allow read,write: if false; }
  }
}
) &&
        text(d.folderId,10,200) && d.folderId.matches('^[a-zA-Z0-9_-]+
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","theme"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","theme"]) &&
        metadata(d,uid) &&
        d.theme in ["light","dark"];
    }

    function valid_sync(d,uid,id) {
      return id=='state' &&
        d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","domains","counts"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","domains","counts"]) &&
        metadata(d,uid) && d.revision is int && d.revision>=1 &&
        d.domains is map && d.counts is map &&
        d.domains.keys().hasAll(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.domains.keys().hasOnly(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.counts.keys().hasAll(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.counts.keys().hasOnly(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        valid_sync_counts(d.domains) && valid_sync_counts(d.counts);
    }
    function valid_sync_counts(d) {
      return d.clients is int && d.clients>=0 && d.clients<1000000 &&
        d.projects is int && d.projects>=0 && d.projects<1000000 &&
        d.tasks is int && d.tasks>=0 && d.tasks<1000000 &&
        d.deliveries is int && d.deliveries>=0 && d.deliveries<1000000 &&
        d.events is int && d.events>=0 && d.events<1000000 &&
        d.financeEntries is int && d.financeEntries>=0 && d.financeEntries<1000000 &&
        d.activities is int && d.activities>=0 && d.activities<1000000;
    }
    function hasRegistration(d) {
      return d.keys().hasAll(["studioName","professionalType","registrationCompletedAt","dataAcknowledgedAt"]);
    }
    function modernProfile(d) {
      return hasRegistration(d) && text(d.displayName,2,120) &&
        text(d.studioName,0,120) &&
        d.professionalType in ["freelancer","studio","producer","other"] &&
        d.registrationCompletedAt is timestamp &&
        d.dataAcknowledgedAt is timestamp;
    }
    function legacyProfile(d) {
      // Accounts created before explicit onboarding keep their original registration state.
      // A legacy account may opt to configure studio/occupation without fake consent timestamps.
      return !d.keys().hasAny(["registrationCompletedAt","dataAcknowledgedAt"]) &&
        ((!d.keys().hasAny(["studioName","professionalType"])) ||
         (d.keys().hasAll(["studioName","professionalType"]) &&
          text(d.studioName,0,120) &&
          d.professionalType in ["freelancer","studio","producer","other"]));
    }
    function valid_profile(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","displayName","email","photoURL"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","displayName","email","photoURL","studioName","professionalType","registrationCompletedAt","dataAcknowledgedAt"]) &&
        metadata(d,uid) &&
        text(d.displayName,0,500) &&
        text(d.email,0,254) && (d.email=='' || d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
        text(d.photoURL,0,2048) && (d.photoURL=='' || d.photoURL.matches('^https://.*$')) &&
        (modernProfile(d) || legacyProfile(d));
    }
    function immutableRegistration(d) {
      return (legacyProfile(resource.data) && legacyProfile(d)) ||
        (modernProfile(resource.data) && modernProfile(d) &&
         d.registrationCompletedAt==resource.data.registrationCompletedAt &&
         d.dataAcknowledgedAt==resource.data.dataAcknowledgedAt);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // New users must complete the registration form. Legacy users keep their original profile.
      allow create: if owner(uid) && valid_profile(request.resource.data,uid,uid) &&
        modernProfile(request.resource.data) &&
        request.resource.data.registrationCompletedAt==request.time &&
        request.resource.data.dataAcknowledgedAt==request.time &&
        creating(request.resource.data);
      allow update: if owner(uid) && valid_profile(request.resource.data,uid,uid) &&
        immutableRegistration(request.resource.data) &&
        request.resource.data.email==resource.data.email &&
        request.resource.data.photoURL==resource.data.photoURL &&
        updating(request.resource.data);
      allow delete: if false; // Account deletion requires a future explicit cleanup process.
      match /clients/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_clients(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_clients(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /projects/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_projects(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_projects(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /tasks/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_tasks(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_tasks(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /deliveries/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_deliveries(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_deliveries(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /events/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_events(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_events(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /financeEntries/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_financeEntries(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_financeEntries(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /activities/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_activities(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_activities(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      // Private per-UID revision counters; no shared hot document across accounts.
      match /sync/{id} {
        allow read: if member(uid) && id=='state';
        allow create: if member(uid) && valid_sync(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_sync(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if false;
      }
      match /preferences/{id} {
        allow read: if member(uid) && id=='ui';
        allow create: if member(uid) && id=='ui' && valid_preferences(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && id=='ui' && valid_preferences(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid) && id=='ui';
      }
    }
    match /{document=**} { allow read,write: if false; }
  }
}
) &&
        text(d.folderName,1,250) && d.createdAt==request.time &&
        id==string(d.projectId)+'_'+d.connectionId+'_'+d.folderId;
    }
    function valid_preferences(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","theme"]) && d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","theme"]) &&
        metadata(d,uid) &&
        d.theme in ["light","dark"];
    }

    function valid_sync(d,uid,id) {
      return id=='state' &&
        d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","domains","counts"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","domains","counts"]) &&
        metadata(d,uid) && d.revision is int && d.revision>=1 &&
        d.domains is map && d.counts is map &&
        d.domains.keys().hasAll(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.domains.keys().hasOnly(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.counts.keys().hasAll(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        d.counts.keys().hasOnly(["clients","projects","tasks","deliveries","events","financeEntries","activities"]) &&
        valid_sync_counts(d.domains) && valid_sync_counts(d.counts);
    }
    function valid_sync_counts(d) {
      return d.clients is int && d.clients>=0 && d.clients<1000000 &&
        d.projects is int && d.projects>=0 && d.projects<1000000 &&
        d.tasks is int && d.tasks>=0 && d.tasks<1000000 &&
        d.deliveries is int && d.deliveries>=0 && d.deliveries<1000000 &&
        d.events is int && d.events>=0 && d.events<1000000 &&
        d.financeEntries is int && d.financeEntries>=0 && d.financeEntries<1000000 &&
        d.activities is int && d.activities>=0 && d.activities<1000000;
    }
    function hasRegistration(d) {
      return d.keys().hasAll(["studioName","professionalType","registrationCompletedAt","dataAcknowledgedAt"]);
    }
    function modernProfile(d) {
      return hasRegistration(d) && text(d.displayName,2,120) &&
        text(d.studioName,0,120) &&
        d.professionalType in ["freelancer","studio","producer","other"] &&
        d.registrationCompletedAt is timestamp &&
        d.dataAcknowledgedAt is timestamp;
    }
    function legacyProfile(d) {
      // Accounts created before explicit onboarding keep their original registration state.
      // A legacy account may opt to configure studio/occupation without fake consent timestamps.
      return !d.keys().hasAny(["registrationCompletedAt","dataAcknowledgedAt"]) &&
        ((!d.keys().hasAny(["studioName","professionalType"])) ||
         (d.keys().hasAll(["studioName","professionalType"]) &&
          text(d.studioName,0,120) &&
          d.professionalType in ["freelancer","studio","producer","other"]));
    }
    function valid_profile(d,uid,id) {
      return d.keys().hasAll(["ownerUid","schemaVersion","revision","createdAt","updatedAt","displayName","email","photoURL"]) &&
        d.keys().hasOnly(["ownerUid","schemaVersion","revision","createdAt","updatedAt","displayName","email","photoURL","studioName","professionalType","registrationCompletedAt","dataAcknowledgedAt"]) &&
        metadata(d,uid) &&
        text(d.displayName,0,500) &&
        text(d.email,0,254) && (d.email=='' || d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
        text(d.photoURL,0,2048) && (d.photoURL=='' || d.photoURL.matches('^https://.*$')) &&
        (modernProfile(d) || legacyProfile(d));
    }
    function immutableRegistration(d) {
      return (legacyProfile(resource.data) && legacyProfile(d)) ||
        (modernProfile(resource.data) && modernProfile(d) &&
         d.registrationCompletedAt==resource.data.registrationCompletedAt &&
         d.dataAcknowledgedAt==resource.data.dataAcknowledgedAt);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // New users must complete the registration form. Legacy users keep their original profile.
      allow create: if owner(uid) && valid_profile(request.resource.data,uid,uid) &&
        modernProfile(request.resource.data) &&
        request.resource.data.registrationCompletedAt==request.time &&
        request.resource.data.dataAcknowledgedAt==request.time &&
        creating(request.resource.data);
      allow update: if owner(uid) && valid_profile(request.resource.data,uid,uid) &&
        immutableRegistration(request.resource.data) &&
        request.resource.data.email==resource.data.email &&
        request.resource.data.photoURL==resource.data.photoURL &&
        updating(request.resource.data);
      allow delete: if false; // Account deletion requires a future explicit cleanup process.
      match /clients/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_clients(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_clients(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /projects/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_projects(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_projects(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /tasks/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_tasks(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_tasks(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /deliveries/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_deliveries(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_deliveries(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /events/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_events(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_events(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /financeEntries/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_financeEntries(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_financeEntries(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      match /activities/{id} {
        allow read: if member(uid);
        allow create: if member(uid) && valid_activities(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_activities(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid);
      }
      // Private per-UID revision counters; no shared hot document across accounts.
      match /sync/{id} {
        allow read: if member(uid) && id=='state';
        allow create: if member(uid) && valid_sync(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && valid_sync(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if false;
      }
      match /preferences/{id} {
        allow read: if member(uid) && id=='ui';
        allow create: if member(uid) && id=='ui' && valid_preferences(request.resource.data,uid,id) && creating(request.resource.data);
        allow update: if member(uid) && id=='ui' && valid_preferences(request.resource.data,uid,id) && updating(request.resource.data);
        allow delete: if member(uid) && id=='ui';
      }
    }
    match /{document=**} { allow read,write: if false; }
  }
}
